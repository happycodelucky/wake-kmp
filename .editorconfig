# Wake — editor + ktlint configuration (CLAUDE.md §3).
#
# ktlint reads this file natively. max_line_length = 120 is the real line
# limit (CLAUDE.md §3) — without it, ktlint assumes unlimited width and demands
# single-line collapses. detekt's MaxLineLength is deliberately looser (140, see
# config/detekt/detekt.yml) so it never rejects a line ktlint has accepted.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = official
